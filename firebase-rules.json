{
  "rules": {
    ".read": false,
    ".write": false,
    "menu": {
      ".read": true,
      ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('menu').val() === true))"
    },
    "branches": {
      ".read": true,
      ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('branches').val() === true))",
      "$id": {
        "image": {
          ".validate": "newData.isString() && newData.val().length <= 700000"
        },
        "mapUrl": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },
    "settings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
      "adminConfigured": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'"
      },
      "ownerEmail": {
        ".read": "auth != null && auth.token.email === data.val()",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
        ".validate": "newData.isString() && newData.val().length <= 120"
      },
      "features": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
        "telegramBot": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('settings').val() === true))",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "workerHeartbeat": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "pythonWorker": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isBoolean()"
        },
        "vapidPublicKey": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      },
      "payments": {
        ".read": true,
        ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('settings').val() === true))"
      },
      "governorates": {
        ".read": true,
        ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('settings').val() === true))"
      },
      "telegram": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('settings').val() === true)) || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('orders').val() === true)))",
        ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('settings').val() === true))"
      },
      "drive": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('settings').val() === true))"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "(auth != null && !root.child('settings').child('adminConfigured').exists()) || auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
      "$uid": {
        ".validate": "newData.hasChildren(['name','email','role']) && newData.child('role').isString()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'staff')"
        },
        "$other": {
          ".validate": "!newData.isString() || newData.val().length <= 200"
        },
        "boundDevice": {
          ".write": "(auth != null && auth.uid === $uid && !data.exists()) || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' && (auth.uid !== $uid || auth.token.email_verified === true))",
          ".validate": "!newData.exists() || (newData.hasChildren(['id','at']) && newData.child('id').isString() && newData.child('id').val().length <= 64 && newData.child('at').isNumber())",
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "$other": {
            ".validate": true
          }
        },
        "deviceRequest": {
          ".write": "(auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner')",
          ".validate": "!newData.exists() || (newData.hasChildren(['id','at']) && newData.child('id').isString() && newData.child('id').val().length <= 64 && newData.child('at').isNumber())",
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "$other": {
            ".validate": true
          }
        },
        ".write": "(auth != null && !root.child('settings').child('adminConfigured').exists()) || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner') || (auth != null && auth.uid === $uid && auth.token.email_verified === true && auth.token.email === root.child('settings').child('ownerEmail').val() && newData.child('role').val() === 'owner')"
      }
    },
    "broadcasts": {
      ".read": true,
      ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('menu').val() === true))",
      ".indexOn": [
        "createdAt"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['title','createdAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": "!newData.isString() || newData.val().length <= 1000"
        }
      }
    },
    "subscribers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['createdAt'])",
        "createdAt": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() > now - 600000 && newData.val() < now + 600000"
        },
        "lastSeen": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() < now + 600000"
        },
        "lang": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "ua": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "standalone": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "fcmToken": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "webPush": {
          ".write": true,
          ".validate": "!newData.isString() || newData.val().length <= 2000"
        },
        "linked": {
          ".read": true,
          ".validate": "newData.isBoolean()"
        },
        "telegramChatId": {
          ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
        },
        "$other": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).exists()"
        }
      }
    },
    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "createdAt",
        "status"
      ],
      "$id": {
        ".read": true,
        ".write": "!data.exists() ? true : (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('orders').val() === true && (!root.child('admins').child(auth.uid).child('branchId').exists() || root.child('admins').child(auth.uid).child('branchId').val() === '' || root.child('admins').child(auth.uid).child('branchId').val() === data.child('branchId').val())))",
        ".validate": "(!data.exists() ? (newData.child('createdAt').val() > now - 600000 && newData.child('createdAt').val() < now + 600000) : true) && newData.hasChildren(['items','total','customerName','customerPhone','status','createdAt']) && (!newData.child('subtotal').exists() || newData.child('total').val() === newData.child('subtotal').val() + (newData.child('deliveryFee').exists() ? newData.child('deliveryFee').val() : 0))",
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "subtotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "deliveryFee": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "customerName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "customerPhone": {
          ".validate": "newData.isString() && newData.val().length <= 25"
        },
        "address": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "paymentRef": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(new|preparing|ready|completed|cancelled)$/)"
        },
        "items": {
          ".validate": "newData.hasChildren()",
          "$i": {
            "$f": {
              ".validate": "!newData.isString() || newData.val().length <= 300"
            }
          }
        },
        "$other": {
          ".validate": "!newData.isString() || newData.val().length <= 2000"
        },
        "decidedVia": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "hasProof": {
          ".validate": "newData.isBoolean()"
        },
        "statusHistory": {
          "$s": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "!data.exists() ? auth == null || auth != null && root.child('admins').child(auth.uid).exists() : (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('feedback').val() === true))",
        ".validate": "newData.hasChildren(['date']) && (!data.exists() ? (newData.child('date').val() > now - 600000 && newData.child('date').val() < now + 600000) : true)",
        "date": {
          ".validate": "newData.isNumber()"
        },
        "answers": {
          ".validate": "newData.hasChildren()",
          "$a": {
            "question": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "answer": {
              ".validate": "newData.isNumber() ? (newData.val() >= 0 && newData.val() <= 5) : (newData.isString() && newData.val().length <= 1000)"
            },
            "$o": {
              ".validate": "!newData.isString() || newData.val().length <= 300"
            }
          }
        },
        "$other": {
          ".validate": "!newData.isString() || newData.val().length <= 1000"
        }
      }
    },
    "uploads": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".validate": "newData.hasChildren(['status'])",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|done|error)$/)"
        },
        "$other": {
          ".validate": "!newData.isString() || newData.val().length <= 900000"
        }
      }
    },
    "backups": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
      "log": {
        "$id": {
          ".validate": "newData.hasChildren(['at','kind']) && newData.child('at').isNumber() && newData.child('kind').isString() && newData.child('kind').val().length <= 30",
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "size": {
            ".validate": "newData.isNumber()"
          },
          "parts": {
            ".validate": "newData.hasChildren() || newData.val() == null"
          },
          "$o": {
            ".validate": true
          }
        }
      }
    },
    "orderProofs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('orders').val() === true))",
        ".validate": "newData.isString() && newData.val().length <= 900000 && newData.val().beginsWith('data:image/')"
      }
    },
    "ratings": {
      ".read": true,
      "$pid": {
        ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,40}$/)",
        "$rater": {
          ".write": "(auth != null && $rater === auth.uid) || (auth == null && $rater.matches(/^[a-z0-9]{8,40}$/)) || (auth != null && !newData.exists() && root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['v','at']) && newData.child('at').val() > now - 300000 && newData.child('at').val() < now + 300000",
          "v": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        }
      }
    },
    "assets": {
      ".read": true,
      "$id": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('menu').val() === true)) || (auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' || (auth != null && root.child('admins').child(auth.uid).child('permissions').child('branches').val() === true)) || auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'",
        ".validate": "$id.matches(/^[0-9a-f]{8,40}$/) && (!newData.exists() || (newData.isString() && newData.val().length <= 900000 && newData.val().matches(/^data:image\\//)))"
      }
    }
  }
}
